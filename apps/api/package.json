{
  "name": "@noc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "bootstrap-admin": "tsx --env-file-if-exists=../../.env scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "^1.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@noc/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.9.0",
    "jose": "^6.0.0",
    "pino": "^9.9.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
