# Copy to .env and fill in. Never commit .env. Generate secrets with: openssl rand -hex 32

# --- PostgreSQL (compose) ---
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgres://noc:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/noc_dev
TEST_DATABASE_URL=postgres://noc:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/noc_test
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=28800
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info
# Optional static bearer for Prometheus scrapes of /metrics (min 24 chars)
METRICS_TOKEN=
# Max body for /api/v1/ingest/* and detection-rule imports (bytes; 64 KiB..32 MiB)
INGEST_BODY_LIMIT_BYTES=4194304

# In-process executor for platform-run TCP availability checks
MONITORING_SCHEDULER_ENABLED=true
MONITORING_TICK_SECONDS=15
MONITORING_MAX_CONCURRENCY=8

# Policy-driven purge of events/metrics/observations (audit trail is never purged)
# Inline-prevention watchdog (detect-only fallback for silent/unhealthy sensors)
IPS_WATCHDOG_ENABLED=true
IPS_WATCHDOG_INTERVAL_SECONDS=60
RETENTION_ENABLED=true
RETENTION_INTERVAL_MINUTES=60

# Shared rate-limit store when running more than one API instance (redis://host:6379/0)
# Also enables the cross-instance alert stream bus (Redis pub/sub).
REDIS_URL=

# --- OIDC single sign-on (optional; all three of ISSUER/CLIENT_ID/REDIRECT_URI enable it) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The web BFF callback: <WEB_ORIGIN>/auth/oidc/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_ROLE_CLAIM=groups
# JSON: {"idp-group": "platform_role_key"}; users whose groups map to nothing get OIDC_DEFAULT_ROLES
OIDC_ROLE_MAP={}
OIDC_DEFAULT_ROLES=
OIDC_ALLOW_JIT=true
# Never link an existing local account to an SSO identity by e-mail unless you trust the IdP's e-mail claim
OIDC_AUTO_LINK_BY_EMAIL=false
OIDC_DISPLAY_NAME=Single sign-on
# RP-initiated logout: registered post-logout redirect URI at the IdP (unset = local logout only)
OIDC_POST_LOGOUT_REDIRECT_URI=
# Back-channel logout: register https://<api>/api/v1/auth/oidc/backchannel-logout at the IdP

# --- Web (BFF) ---
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ACCESS_TTL_SECONDS=900

# --- Analysis service ---
ANALYSIS_HOST=127.0.0.1
ANALYSIS_PORT=8000
ANALYSIS_ENVIRONMENT=development
ANALYSIS_INTERNAL_TOKEN=
# API → analysis service base URL (advisory scoring only)
ANALYSIS_URL=http://127.0.0.1:8000

# --- First administrator (used once by `pnpm bootstrap-admin`, then remove) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
